# ACEM Academy LMS - Server Environment Configuration Example

# Application
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database (MongoDB connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.example.mongodb.net/acem-lms?retryWrites=true&w=majority

# Authentication Secrets (Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ACCESS_TOKEN_SECRET=replace_with_a_secure_random_string_min_32_characters
ACCESS_TOKEN_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=replace_with_another_secure_random_string_min_32_characters
REFRESH_TOKEN_EXPIRES_IN=7d

# Cookie Security Settings (For cross-domain hosting e.g. Vercel+Render set COOKIE_SAME_SITE=none and COOKIE_SECURE=true)
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# Media Uploads (Cloudinary credentials from cloudinary.com dashboard)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email & SMTP Relay (Brevo / SendGrid / Amazon SES)
DISABLE_EMAIL=false
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
MAIL_FROM="ACEM Academy <noreply@acem.academy>"

# Initial Admin Seeding (Used only when running: npm run seed:admin)
ADMIN_EMAIL=admin@acem.academy
ADMIN_PASSWORD=change_this_admin_password
ADMIN_FULL_NAME=System Administrator
